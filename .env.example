# ================== ALPHA-TRADE config ==================
# Salin jadi .env lalu isi. Jangan commit file .env!

# --- Eksekusi (lihat testnet_executor.py) ---
# off     : hanya sinyal, tanpa order (default, aman)
# paper   : simulasi order lokal, dicatat ke log
# testnet : kirim MARKET order ke Binance TESTNET
EXECUTION_MODE=off

# API key TESTNET (bukan mainnet!):
#   spot    : https://testnet.binance.vision   (login GitHub -> Generate HMAC Key)
#   futures : https://testnet.binancefuture.com
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# AT_PROVIDER=binance     # default: Binance WS realtime (fallback Bybit -> yfinance -> Yahoo raw)
# AT_PROVIDER=yfinance    # polling via library yfinance (GC=F lebih stabil, cocok untuk emas COMEX)
# AT_PROVIDER=yahoo       # polling raw Yahoo chart API
# AT_PROVIDER=mt5         # candle langsung dari terminal MetaTrader 5 lokal (Windows)

# --- MetaTrader 5 Auto-Executor (opsional, Windows + MT5 lokal) ---
# Default STANDBY (OFF) saat boot — aktifkan tombol ARM di dashboard UI.
# Semua parameter di bawah juga bisa diatur langsung dari halaman PENGATURAN UI.
AT_MT5_SYMBOL=            # kosong = auto-detect XAUUSD / XAUUSDm / GOLD dari Market Watch
AT_MT5_PATH=              # opsional path lengkap ke terminal64.exe
AT_MT5_RISK_PCT=1.0       # total % risiko equity per sinyal (split 50% TP1 + 50% TP2)
AT_MT5_MAX_OPEN=1         # maks jumlah pair posisi terbuka bersamaan (0 = tanpa batas)
AT_MT5_MAX_SPREAD=45      # maks spread broker dalam points (0 = nonaktif)
AT_MT5_DAILY_STOP_R=2.0   # stop entry sisa hari UTC setelah rugi >= X R (0 = nonaktif)
AT_MT5_BE_OFFSET=0        # offset poin saat geser SL ke Break Even setelah TP1 kena
AT_MT5_DEVIATION=25       # maks slippage dalam points
AT_MT5_MAGIC=202605       # magic number khusus Alpha-Trade
AT_MT5_DEMO_ONLY=true     # true = tolak akun Real/Contest (pengaman awal)
AT_MT5_TRANSPORT=python   # python (IPC lokal Windows) | mcp (HTTP MCP bawaan MT5 build 6060+)
AT_MT5_MCP_URL=           # mis. http://127.0.0.1:22346/mcp (dari Tools -> Options -> MCP di MT5)
AT_MT5_MCP_KEY=           # Bearer API key dari tab MCP MT5 (jangan pernah commit!)
# --- Feed & simbol ---
AT_SYMBOL=PAXGUSDT        # XAUUSD proxy di Binance spot; BTCUSDT dll juga bisa
AT_LABEL=XAUUSD           # label tampil di dashboard
AT_ENTRY_TF=15m           # timeframe entry (sinyal)
AT_HTF=4h                 # timeframe tren (native dari Binance, bukan resample)
AT_MARKET=spot            # spot | futures
AT_BARS=1500

# --- Dashboard server ---
AT_PORT=8788              # http://localhost:8788
AT_WS_PORT=8789           # ws://localhost:8789

# --- Telegram notifikasi (opsional) ---
TG_TOKEN=
TG_CHAT_ID=

NEWS_KEY_FINNHUB=
