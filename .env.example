# ================== ALPHA-TRADE config ==================
# Salin jadi .env lalu isi. Jangan commit file .env!

# --- Eksekusi (lihat testnet_executor.py) ---
# off     : hanya sinyal, tanpa order (default, aman)
# paper   : simulasi order lokal, dicatat ke log
# testnet : kirim MARKET order ke Binance TESTNET
EXECUTION_MODE=off

# API key TESTNET (bukan mainnet!):
#   spot    : https://testnet.binance.vision   (login GitHub -> Generate HMAC Key)
#   futures : https://testnet.binancefuture.com
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# AT_PROVIDER=binance     # default: Binance WS realtime (fallback Bybit -> yfinance -> Yahoo raw)
# AT_PROVIDER=yfinance    # polling via library yfinance (GC=F lebih stabil, cocok untuk emas COMEX)
# AT_PROVIDER=yahoo       # polling raw Yahoo chart API
# --- Feed & simbol ---
AT_SYMBOL=PAXGUSDT        # XAUUSD proxy di Binance spot; BTCUSDT dll juga bisa
AT_LABEL=XAUUSD           # label tampil di dashboard
AT_ENTRY_TF=15m           # timeframe entry (sinyal)
AT_HTF=4h                 # timeframe tren (native dari Binance, bukan resample)
AT_MARKET=spot            # spot | futures
AT_BARS=1500

# --- Dashboard server ---
AT_PORT=8788              # http://localhost:8788
AT_WS_PORT=8789           # ws://localhost:8789

# --- Telegram notifikasi (opsional) ---
TG_TOKEN=
TG_CHAT_ID=
